<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.primesoft.asyncworldedit</groupId>
    <artifactId>AsyncWorldEdit_AllInOne</artifactId>
    <version>3.5.4</version>
    <packaging>pom</packaging>
    <name>AsyncWorldEdit_AllInOne</name>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Build with JDK 25, emit Java 8 bytecode (v52) for MC 1.8.8 / Java 8 runtime -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <modules>
        <!-- NOTE: JarProcessor module does not exist in tag v3.5.4, removed so
             'mvn package' works. -->
        <module>AsyncWorldEdit</module>
        <module>AsyncWorldEdit-ActionBarAPI</module>
        <module>AsyncWorldEdit-ActionMessager</module>
        <module>AsyncWorldEdit-API</module>
        <module>AsyncWorldEdit-APIInner</module>
        <module>AsyncWorldEdit-BarAPI</module>
        <module>AsyncWorldEdit-BlocksHub_v1x</module>
        <module>AsyncWorldEdit-BlocksHub_v2x</module>
        <module>AsyncWorldEdit-BountifulAPI</module>
        <module>AsyncWorldEdit-Deploy</module>
        <module>AsyncWorldEditInjector</module>
        <module>AsyncWorldEdit-PlotMe013g</module>
        <module>AsyncWorldEdit-PlotMeCore015</module>
        <module>AsyncWorldEdit-PlotMeCore016</module>        
        <module>AsyncWorldEdit-spigot_v1_10_R1</module>
        <module>AsyncWorldEdit-spigot_v1_11_R1</module>
        <module>AsyncWorldEdit-spigot_v1_12_R1</module>
        <module>AsyncWorldEdit-spigot_v1_12_R1_12_1</module>
        <module>AsyncWorldEdit-spigot_v1_8_R3</module>
        <module>AsyncWorldEdit-spigot_v1_9_R1</module>
        <module>AsyncWorldEdit-spigot_v1_9_R2</module>
        <module>AsyncWorldEdit-TitleManager</module>
        <module>AsyncWorldEdit-Utils</module>
        <module>AsyncWorldEdit-WelcomeTitle</module>
        <!-- Slim 1.8.8-only distribution, builds with JDK 25 (see module) -->
        <module>AsyncWorldEdit-Deploy18</module>
    </modules>

    <repositories>
        <!-- Needed to resolve org.bukkit:bukkit version ranges on modern setups -->
        <repository>
            <id>spigotmc-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>
</project>